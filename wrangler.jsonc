// Cloudflare Workers: statiske filer fra dist/ + en lille worker (worker/index.js).
//
// Hvorfor Workers og ikke Pages (som techfeedwatch bruger): Pages omdirigerer
// ALTID /navn.html til /navn. Bloggers adresser ender på .html, og de skal blive
// ved med at svare 200 direkte — ellers skal Google flytte alle 193 adresser.
// Med html_handling "none" serverer Workers /navn.html præcis som den er.
//
// Prisen: "/" og mapper finder ikke index.html af sig selv. Det klarer workeren,
// som også står for omdirigeringer fra Bloggers gamle adresser og robots.txt.
{
  "name": "techmediaarch",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    // Videoer går gennem workeren, som kan sende dem i stykker (206) — Safari kræver
    // det. De statiske filer alene svarer altid med hele filen. Se video() i worker/index.js.
    "run_worker_first": ["/video/*"]
  },
  // Test-adressen techmediaarch.<konto>.workers.dev er slået til (trin 4).
  // Forhåndsvisnings-adresser pr. version slås fra: de ville ikke være dækket af
  // noindex-reglen i public/_headers.
  "workers_dev": true,
  // Trin 5 (25/9-2026): det rigtige domæne sendes til denne Worker via ruter.
  // DNS-records er IKKE ændret — Blogger ligger urørt bagved. Fortryd = fjern
  // ruterne her og kør "npx wrangler deploy" igen (eller slet dem i Cloudflare
  // under techmediaarch.com → Workers Routes); så svarer Blogger straks igen.
  // Kun www: techmediaarch.com (uden www) sendes til www af Cloudflare-reglen
  // "Apex to www (replaces Blogger redirect)" under Rules → Redirect Rules (oprettet
  // 25/9, 301, søgedelen bevares). Blogger bruges altså ikke længere til det.
  // Læg IKKE en rute på techmediaarch.com: den ville servere filerne uden omdirigering.
  "routes": [
    { "pattern": "www.techmediaarch.com/*", "zone_name": "techmediaarch.com" }
  ],
  "preview_urls": false,
  "observability": { "enabled": true }
}
