---
// Knapperne øverst på forsiden, hyldesiderne og de øvrige emnesider.
// Fra trin 4 (28/10-2026): de 5 hylder (med farveprik og antal) i stedet for de 14 gamle emner,
// plus "A–Z" til alle artikler. Links til siderne (ingen filtrering i browseren).
// aktiv: hyldens slug (fx "cybersecurity") eller udeladt på forsiden.
import { HYLDER, hyldeUrl, iHylde } from '../lib/hylder';
interface Props { aktiv?: string; }
const { aktiv } = Astro.props;
---
<nav class="chip-bar" aria-label="Shelves">
  <a href="/" class={`chip ${!aktiv ? 'active' : ''}`}>All</a>
  {HYLDER.map((h) => (
    <a href={hyldeUrl(h)} class={`chip chip-hylde ${aktiv === h.slug ? 'active' : ''}`} style={`--h-farve: ${h.farve}`} aria-current={aktiv === h.slug ? 'page' : undefined}>
      <span class="chip-prik" aria-hidden="true"></span>{h.navn}<span class="chip-count">{iHylde(h).length}</span>
    </a>
  ))}
  <a href="/a-z" class={`chip ${aktiv === 'a-z' ? 'active' : ''}`}>A–Z</a>
</nav>
