---
// Emnerne som chips — samme pille-design som techfeedwatchs emnefilter, men som
// links til emnesiderne (ingen filtrering i browseren).
import { KATEGORIER, emneUrl } from '../lib/emner';
import { iEmne } from '../lib/indhold';
interface Props { aktiv?: string; }
const { aktiv } = Astro.props;
const emner = KATEGORIER.map((e) => ({ e, n: iEmne(e).length })).filter((x) => x.n > 0);
---
<div class="chip-bar">
  <a href="/" class={`chip ${!aktiv ? 'active' : ''}`}>All</a>
  {emner.map(({ e, n }) => (
    <a href={emneUrl(e)} class={`chip chip-accent ${aktiv === e.slug ? 'active' : ''}`} style={`--tag-accent: ${e.farve}`}>{e.navn}<span class="chip-count">{n}</span></a>
  ))}
</div>
