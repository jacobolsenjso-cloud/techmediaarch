---
// Sitets logo i kort uden billede. Jacob 30/10-2026: logoet skal være ens alle steder, så det er
// præcis samme fil som i topbjælken og faneikonet (public/logo.svg, laves af scripts/lav-logo.mjs).
interface Props { class?: string; id?: string; }
const { class: klasse = '' } = Astro.props;
---
<img class:list={['maerke', klasse]} src="/logo.svg" alt="" width="40" height="40" loading="lazy" decoding="async" />
