---
// Hyldeside (trin 4, 28/10-2026): /shelf/<slug> — en af svar-arkivets 5 hylder.
// Afløser emnesiderne for de emner, der hører til hylden (workeren sender /topic/<emne> hertil med 301).
// Opbygning efter designlærredet: hyldens navn, "Start here" (en kort læserækkefølge), alle artikler nyeste først,
// og en sidekolonne. Listerne er <a> i <div>/<ol>, ingen afsnit mellem punkterne (Auto-annoncer, se artikelsiden).
import MainLayout from '../../layouts/MainLayout.astro';
import EmneChips from '../../components/EmneChips.astro';
import { HYLDER, hyldeUrl, iHylde, svarIHylde, arkivIHylde, hyldeSorteret, startListe } from '../../lib/hylder';
import { datoTekst } from '../../lib/indhold';

export function getStaticPaths() {
  return HYLDER.map((h) => ({ params: { shelf: h.slug }, props: { h } }));
}
const { h } = Astro.props;
const SITE = 'https://www.techmediaarch.com';
const liste = iHylde(h);
const svar = svarIHylde(h);
const arkiv = arkivIHylde(h);
const start = startListe(h);
const schema = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: h.navn, description: h.besk,
  url: SITE + hyldeUrl(h),
  mainEntity: { '@type': 'ItemList', itemListElement: hyldeSorteret(h).slice(0, 30).map((p, i) => ({ '@type': 'ListItem', position: i + 1, url: SITE + p.href })) },
};
---
<MainLayout title={`${h.navn}: answers and guides`} description={`${h.besk} ${liste.length} articles on the ${h.navn} shelf of Tech Media Arch${start.length ? ', with a short reading path to start with' : ''}.`}
  schema={schema} breadcrumb={[{ navn: h.navn, href: hyldeUrl(h) }]}>
  <style is:global>
    .hylde-top { display: flex; align-items: center; gap: 18px; margin: 8px 0 28px; }
    .hylde-ikon { flex: none; width: 64px; height: 64px; border-radius: 15px; background: color-mix(in srgb, var(--h-farve) 15%, var(--card-bg)); color: var(--h-farve); display: flex; align-items: center; justify-content: center; }
    .hylde-ikon svg { width: 32px; height: 32px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .hylde-titel { margin: 0; font-size: clamp(2rem, 4vw, 3rem); line-height: 1.05; font-weight: 700; font-stretch: 92%; letter-spacing: -0.02em; }
    .hylde-besk { margin: 6px 0 0; font-family: var(--font-serif); font-size: 1.15rem; line-height: 1.5; color: var(--ink-2); }
    .hylde-besk span { color: var(--muted); }
    .hylde-grid { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: 32px; align-items: start; margin-bottom: 48px; }
    .hylde-main { display: flex; flex-direction: column; gap: 36px; min-width: 0; }
    .hylde-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
    .hylde-start { background: var(--card-bg); border: 1px solid var(--rule-light); border-radius: 15px; padding: 24px 26px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 10px; }
    .hylde-start .hylde-label { color: var(--teal-text); }
    .hylde-start h2 { margin: 0 0 4px; font-size: 1.45rem; line-height: 1.2; }
    .hylde-start-liste { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
    .hylde-start-liste li { display: flex; align-items: center; gap: 14px; padding: 12px 0; border-top: 1px solid var(--rule-light); }
    .hylde-nr { flex: none; width: 34px; height: 34px; border-radius: 10px; background: var(--teal); color: var(--bg-color); font-weight: 700; display: flex; align-items: center; justify-content: center; }
    .hylde-start-liste a { font-size: 1.05rem; font-weight: 650; line-height: 1.35; color: var(--text-color); text-decoration: none; }
    .hylde-start-liste a:hover { color: var(--teal-text); }
    .hylde-liste { display: flex; flex-direction: column; }
    .hylde-tom { margin: 8px 0 0; font-family: var(--font-serif); color: var(--muted); }
    .hylde-raekke { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--rule-light); color: var(--text-color); text-decoration: none; }
    .hylde-raekke img, .hylde-raekke-tom { width: 112px; aspect-ratio: 16 / 10; object-fit: cover; border-radius: 10px; display: block; background: var(--placeholder); }
    .hylde-raekke-tekst { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
    .hylde-raekke-titel { font-size: 1.05rem; font-weight: 650; line-height: 1.35; }
    .hylde-raekke:hover .hylde-raekke-titel { color: var(--teal-text); }
    .hylde-raekke-meta { font-family: var(--font-mono); font-size: 12px; color: var(--muted); }
    .hylde-side { display: flex; flex-direction: column; gap: 18px; position: sticky; top: 84px; }
    .hylde-boks { background: var(--card-bg); border: 1px solid var(--rule-light); border-radius: 15px; padding: 20px 22px; box-shadow: var(--shadow); display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.55; }
    .hylde-boks a { font-size: 14px; font-weight: 600; color: var(--teal-text); text-decoration: none; }
    .hylde-boks a:hover { text-decoration: underline; }
    @media (max-width: 900px) { .hylde-grid { grid-template-columns: minmax(0, 1fr); } .hylde-side { position: static; } }
    @media (max-width: 600px) { .hylde-top { gap: 14px; } .hylde-ikon { width: 52px; height: 52px; } .hylde-start { padding: 18px; } .hylde-raekke { grid-template-columns: 84px minmax(0, 1fr); gap: 12px; } .hylde-raekke img, .hylde-raekke-tom { width: 84px; } }
  </style>

  <div class="page-wrapper" style="padding-top: 24px;">
    <EmneChips aktiv={h.slug} />

    <header class="hylde-top" style={`--h-farve: ${h.farve}`}>
      <span class="hylde-ikon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={h.ikon} /></svg></span>
      <div>
        <h1 class="hylde-titel">{h.navn}</h1>
        <p class="hylde-besk">{h.besk} <span>{svar.length} {svar.length === 1 ? 'answer' : 'answers'} · {liste.length} articles in all.</span></p>
      </div>
    </header>

    <div class="hylde-grid">
      <div class="hylde-main">
        {start.length > 0 && (
          <section class="hylde-start" aria-labelledby="start-h">
            <span class="hylde-label">Start here · read in this order</span>
            <h2 id="start-h">{start.length} answers that build on each other</h2>
            <ol class="hylde-start-liste">
              {start.map((p, i) => <li><span class="hylde-nr" aria-hidden="true">{i + 1}</span><a href={p.href}>{p.title}</a></li>)}
            </ol>
          </section>
        )}

        {/* Skridt 3 (Jacob 29/10-2026): svarene (robotsvar + tidløse ældre artikler, src/lib/hyldeplan.mjs) står øverst;
            ældre nyheder og værktøjsanmeldelser står i arkivet nedenunder — de er stadig på sitet, men læseren møder svarene først. */}
        <section aria-labelledby="svar-h">
          <div class="section-heading"><h2 id="svar-h">Answers on this shelf</h2><span class="section-note">{svar.length}, newest first</span></div>
          {svar.length > 0 ? (
            <div class="hylde-liste">
              {svar.map((p, i) => (
                <a href={p.href} class="hylde-raekke">
                  {p.image ? <img src={p.image} alt="" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" /> : <span class="hylde-raekke-tom" aria-hidden="true"></span>}
                  <span class="hylde-raekke-tekst">
                    <span class="hylde-raekke-titel">{p.title}</span>
                    <span class="hylde-raekke-meta">{datoTekst(p.published)} · {p.minutter} min read</span>
                  </span>
                </a>
              ))}
            </div>
          ) : <p class="hylde-tom">The first answers for this shelf are being written.</p>}
        </section>

        {arkiv.length > 0 && (
          <section aria-labelledby="arkiv-h">
            <div class="section-heading"><h2 id="arkiv-h">From the archive</h2><span class="section-note">{arkiv.length} older news stories and tool reviews</span></div>
            <div class="hylde-liste">
              {arkiv.map((p) => (
                <a href={p.href} class="hylde-raekke">
                  {p.image ? <img src={p.image} alt="" loading="lazy" decoding="async" /> : <span class="hylde-raekke-tom" aria-hidden="true"></span>}
                  <span class="hylde-raekke-tekst">
                    <span class="hylde-raekke-titel">{p.title}</span>
                    <span class="hylde-raekke-meta">{datoTekst(p.published)} · {p.minutter} min read</span>
                  </span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="hylde-side" aria-label="About this shelf">
        <div class="hylde-boks">
          <span class="hylde-label">About this shelf</span>
          <span>Newer answers start from a real question people search for, give the short answer first and name their sources.</span>
          <a href="/p/editorial-guidelines">How we work →</a>
        </div>
        <div class="hylde-boks">
          <span class="hylde-label">Missing a question?</span>
          <span>Tell me what you searched for, and it goes on the list for this shelf.</span>
          <a href="/p/contact-us">Write to me →</a>
        </div>
        <div class="hylde-boks">
          <span class="hylde-label">Other shelves</span>
          {HYLDER.filter((x) => x.slug !== h.slug).map((x) => <a href={hyldeUrl(x)}>{x.navn}</a>)}
        </div>
      </aside>
    </div>
  </div>
</MainLayout>
