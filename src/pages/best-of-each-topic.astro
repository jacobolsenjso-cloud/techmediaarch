---
// Best of each topic (30/9-2026): pr. emne de 4 mest læste artikler de sidste 90 dage, målt med Google Analytics
// (Jacobs valg; først Search Console-klik, men der var kun 7 på 90 dage). Sat op som techfeedwatchs /popular:
// sektion pr. emne, mærke på kortet, "See all N →" og en boks, der ærligt siger, hvad der måles, og hvad der ikke gør.
// Ingen tal på kortene (kun rang), fordi Analytics kun tæller besøgende, der siger ja til cookies. Tallene: src/lib/bedste.ts.
import MainLayout from '../layouts/MainLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EmneChips from '../components/EmneChips.astro';
import { emneUrl } from '../lib/emner';
import { BEDSTE, SEKTIONER, HAR_BEDSTE, PR_EMNE, kortDato } from '../lib/bedste';

const SITE = 'https://www.techmediaarch.com';
const title = 'Best of each topic';
const description = 'The most-read Tech Media Arch articles in each topic over the last 90 days. Four per topic.';
const fra = kortDato(BEDSTE.fra), til = kortDato(BEDSTE.til), hentet = kortDato(BEDSTE.hentet);

// CollectionPage + ItemList: kun det siden faktisk viser. En artikel i to emner står kun én gang i listen.
const viste = [...new Map(SEKTIONER.flatMap((s) => s.artikler).map((p) => [p.sti, p])).values()];
const schema = HAR_BEDSTE ? {
  '@context': 'https://schema.org', '@type': 'CollectionPage', name: title, url: `${SITE}/best-of-each-topic`, description,
  isPartOf: { '@type': 'WebSite', name: 'Tech Media Arch', url: `${SITE}/` },
  publisher: { '@id': `${SITE}/#organization` },
  mainEntity: { '@type': 'ItemList', numberOfItems: viste.length,
    itemListElement: viste.map((p, n) => ({ '@type': 'ListItem', position: n + 1, url: SITE + p.href, name: p.title })) },
} : null;
---
<MainLayout title={title} description={description} schema={schema} noindex={!HAR_BEDSTE} breadcrumb={[{ navn: 'Best of each topic', href: '/best-of-each-topic' }]}>
  <style is:global>
    .best-sub { color: var(--muted); font-size: 1.02rem; line-height: 1.6; margin: 0 0 20px; max-width: 780px; }
    .best-method { background: var(--card-bg); border: 1px solid var(--border-color); border-left: 4px solid var(--teal); border-radius: 12px; padding: 16px 20px; margin: 0 0 34px; max-width: 900px; }
    .best-method p { font-size: 0.9rem; line-height: 1.6; color: var(--muted); margin: 0 0 8px; }
    .best-method p:last-child { margin-bottom: 0; }
    .best-method strong { color: var(--text-color); }
    .best-section { margin-bottom: 36px; }
    .best-head { display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; margin: 0 0 12px; }
    .best-head h2 { font-size: 1.3rem; margin: 0; display: flex; align-items: center; gap: 8px; }
    .best-head h2::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--tag-accent); }
    /* padding og min-height gør linket til et tryk-mål på mindst 24x24 (WCAG 2.2 AA), som på techfeedwatch */
    .best-head a { font-size: 0.85rem; color: var(--teal-text); text-decoration: none; font-weight: 600; padding: 4px 2px; min-height: 44px; display: inline-flex; align-items: center; }
    .best-head a:hover { text-decoration: underline; }
    /* 4 kort pr. emne (Jacob 30/9): 4 på én række på computer, 2 x 2 på mobil og smalle skærme — aldrig en enlig på sidste række */
    .best-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
    @media (max-width: 1000px) { .best-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; } }
    /* I de smalle kort er der ikke plads til læsetiden: den brød ud på en ny linje med en løs "·" for enden (målt 30/9) */
    @media (max-width: 600px) { .best-grid .card-meta > :nth-last-child(-n+2) { display: none; } }
    .best-tom { background: var(--card-bg); border: 1px dashed var(--border-color); border-radius: 12px; padding: 22px; max-width: 900px; color: var(--muted); }
  </style>
  <div class="page-wrapper" style="padding-top: 24px;">
    <EmneChips />
    <div class="section-heading"><h1>Best of each topic</h1></div>
    <p class="best-sub">The articles people actually read. For each topic, the four that were read most over the last 90 days.</p>
    <div class="best-method">
      <p><strong>How this is ranked.</strong> How many times each article was read over the last 90 days, measured with Google Analytics. When two articles were read equally often, the one with more different readers comes first. Articles nobody read are left out.</p>
      <p><strong>What it does not measure.</strong> Only visitors who accept analytics cookies are counted, so the ranking shows what is read most, not exact numbers. Newer articles have had less time to be read, and being read often says people chose to open an article, not that it was good.{HAR_BEDSTE && fra && ` Reads from ${fra} to ${til}, refreshed ${hentet}.`}</p>
    </div>
    {HAR_BEDSTE ? SEKTIONER.map((s) => (
      <section class="best-section" style={`--tag-accent: ${s.emne.farve}`}>
        <div class="best-head">
          <h2>{s.emne.navn}</h2>
          <a href={emneUrl(s.emne)}>See all {s.total} →</a>
        </div>
        <div class="best-grid">{s.artikler.slice(0, PR_EMNE).map((p, i) => <ArticleCard p={p} niveau={3} badge={`#${i + 1}`} udenUdsnit />)}</div>
      </section>
    )) : (
      <p class="best-tom">The rankings are being collected. They appear here after the next update from Google Analytics.</p>
    )}
  </div>
</MainLayout>
