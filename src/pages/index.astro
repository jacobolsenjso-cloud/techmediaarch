---
// Forsiden: blåt topbånd med søgning og de 5 hylder (29/10), redaktionel top (én hovedhistorie + fire mindre),
// "Questions people are asking" og fra 28/10 ét afsnit pr. hylde (tidligere et grid med kort).
import MainLayout from '../layouts/MainLayout.astro';
import ArtikelRaekke from '../components/ArtikelRaekke.astro';
import Pagination from '../components/Pagination.astro';
import { INDLAEG, datoTekst, udsnit } from '../lib/indhold';
import { somSporgsmaal, tegnFarve } from '../lib/sporgsmaal.mjs';
import { HYLDER, hyldeFor, hyldeUrl, hyldeSorteret } from '../lib/hylder';
import { FORSIDE_NYESTE, listeSider } from '../lib/liste';

// Forsiden (Jacob 28/10, forslag 2): de 5 nyeste øverst, derefter ét afsnit pr. hylde (1 stor + 3 rækker + "See all").
// Gitteret med 19 kort er væk; "All articles" fortsætter på /page/2 lige efter de 5 nyeste (lib/liste.ts).
const side1 = INDLAEG.slice(0, FORSIDE_NYESTE);
const antalSider = listeSider(INDLAEG.length);
const hoved = side1[0];
const sideHistorier = side1.slice(1, FORSIDE_NYESTE);
// Mærket over titlerne viser hylden (ikke det gamle emnenavn); uden hylde: emnet
const maerke = (p: (typeof INDLAEG)[number]) => { const h = hyldeFor(p); return h ? { navn: h.navn, farve: h.farve } : p.emner[0] ? { navn: p.emner[0].navn, farve: p.emner[0].farve } : null; };
// Hyldeafsnittene: den nyeste med billede som stor, de 3 næste som rækker — svarene først (skridt 3, 29/10-2026),
// så forsiden ikke viser en AI-nyhed fra 2024 som hyldens ansigt
const hyldeAfsnit = HYLDER.map((h) => {
  const liste = hyldeSorteret(h);
  const stor = liste.find((p) => p.image) ?? liste[0];
  return { h, antal: liste.length, stor, smaa: liste.filter((p) => p !== stor).slice(0, 3) };
}).filter((x) => x.stor);

// "Questions people are asking" (29/9, Jacobs ønske): de nyeste robotartiklers Google-søgespørgsmål som genveje.
// Undertitlen lover "this week" — den står kun, når ALLE viste spørgsmål er højst 7 dage gamle (ellers "recently").
const UGE = 7 * 24 * 3600 * 1000;
const sporgsmaal = INDLAEG.filter((p) => p.robot && p.keyword).slice(0, 8)
  .map((p) => { const farve = p.emner[0]?.farve || '#1e40af'; return { href: p.href, tekst: somSporgsmaal(p.keyword), farve, tegn: tegnFarve(farve), dato: new Date(p.published).getTime() }; });
const denneUge = sporgsmaal.length > 0 && sporgsmaal.every((q) => Date.now() - q.dato <= UGE);
---
<MainLayout description="Clear answers to the tech questions people actually ask: AI tools, cybersecurity, building software, marketing and everyday tech, with the sources named.">
  <style is:global>
    /* Søgefeltet i toppen (farverne på det blå bånd står i toppens egen stil længere nede) */
    .home-search { display: flex; max-width: 640px; margin-top: 6px; border-radius: var(--radius); }
    .home-search input { flex: 1; min-width: 0; height: 52px; padding: 0 16px; border: 2px solid var(--teal); border-right: 0; border-radius: var(--radius) 0 0 var(--radius); font: inherit; font-size: 17px; background: var(--card-bg); color: var(--text-color); }
    .home-search input:focus-visible { outline: 2px solid var(--teal); outline-offset: 2px; }
    .home-search button { height: 52px; padding: 0 22px; border: 2px solid var(--teal); background: var(--teal); color: var(--bg-color); font: inherit; font-size: 16px; font-weight: 600; border-radius: 0 var(--radius) var(--radius) 0; cursor: pointer; }
    .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (max-width: 860px) { .home-search input, .home-search button { height: 48px; } }

    .lead-section { display: grid; grid-template-columns: 1.35fr 1fr; gap: 26px; margin-bottom: 42px; align-items: start; }
    .lead-secondary { display: flex; flex-direction: column; gap: 20px; }
    .lead-card { text-decoration: none; color: inherit; display: block; }
    .lead-card .card-thumb { border-radius: var(--radius); margin-bottom: 14px; }
    .lead-card:hover .card-thumb img { transform: scale(1.04); }
    .lead-eyebrow { display: inline-flex; align-items: center; gap: 7px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; margin-bottom: 9px; color: var(--teal-text); }
    .lead-eyebrow::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent, var(--teal)); }
    .lead-title { margin: 0 0 9px 0; font-size: 2rem; line-height: 1.12; font-weight: 700; font-stretch: 92%; letter-spacing: -0.015em; }
    .lead-card:hover .lead-title { color: var(--teal-text); }
    .lead-excerpt { margin: 0 0 11px 0; font-family: var(--font-serif); font-size: 1.06rem; line-height: 1.55; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .lead-mini { display: grid; grid-template-columns: 132px 1fr; gap: 14px; text-decoration: none; color: inherit; align-items: start; }
    .lead-mini .card-thumb { border-radius: var(--radius); margin: 0; }
    .lead-mini-title { margin: 0 0 5px 0; font-size: 1rem; line-height: 1.35; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .lead-mini:hover .lead-mini-title { color: var(--teal-text); }
    .lead-mini-eyebrow { display: flex; width: fit-content; font-size: 0.66rem; margin-bottom: 5px; }
    .lead-mini-eyebrow::before { width: 6px; height: 6px; }
    @media (max-width: 900px) { .lead-section { grid-template-columns: 1fr; gap: 30px; } .lead-title { font-size: 1.45rem; } }
    @media (max-width: 520px) { .lead-mini { grid-template-columns: 110px 1fr; gap: 12px; } .lead-title { font-size: 1.3rem; } .lead-excerpt { -webkit-line-clamp: 2; font-size: 0.95rem; } }

    /* "Questions people are asking" (29/9) — samme udseende som på Jacobs andet site */
    .home-questions { margin: 6px 0 36px; }
    .home-questions-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 6px 22px; }
    .home-question { display: flex; align-items: center; gap: 12px; padding: 10px 12px; min-height: 44px; box-sizing: border-box; border-radius: var(--radius); text-decoration: none; color: var(--text-color); border: 1px solid transparent; transition: background 0.2s, border-color 0.2s, transform 0.2s; }
    .home-question:hover { background: var(--hover-bg); border-color: var(--border-color); transform: translateX(3px); }
    .home-question-mark { flex: none; width: 28px; height: 28px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.9rem; color: #fff; background: var(--tag-accent); }
    .home-question-text { font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
    .home-question-arrow { margin-left: auto; color: #9ca3af; transition: transform 0.15s, color 0.2s; }
    .home-question:hover .home-question-arrow { transform: translateX(3px); color: var(--teal-text); }
    @media (max-width: 768px) { .home-questions-list { grid-template-columns: 1fr; } }
    @media (prefers-reduced-motion: reduce) { .home-question:hover, .home-question:hover .home-question-arrow { transform: none; } }

    /* Forslag 2 (Jacob 28/10): hyldeafsnit — 1 stor artikel til venstre, 3 rækker til højre */
    .hylde-afsnit { display: flex; flex-direction: column; gap: 16px; margin: 0 0 44px; }
    .hylde-afsnit-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; border-bottom: 1px solid var(--border-color); padding-bottom: 10px; }
    .hylde-afsnit-top h2 { margin: 0; font-size: 1.6rem; display: flex; align-items: center; gap: 10px; }
    .hylde-afsnit-top h2::before { content: ''; width: 12px; height: 12px; border-radius: 50%; background: var(--h); }
    .hylde-afsnit-top h2 a { color: inherit; text-decoration: none; }
    .hylde-afsnit-top h2 a:hover { color: var(--teal-text); }
    .hylde-afsnit-alle { font-weight: 600; font-size: 0.95rem; color: var(--teal-text); text-decoration: none; white-space: nowrap; }
    .hylde-afsnit-alle:hover { text-decoration: underline; }
    .hylde-afsnit-grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); gap: 28px; align-items: start; }
    .hylde-stor { display: flex; flex-direction: column; gap: 10px; color: var(--text-color); text-decoration: none; }
    .hylde-stor img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius-lg); display: block; background: var(--placeholder); }
    .hylde-stor-titel { font-size: 1.6rem; font-weight: 700; line-height: 1.2; font-stretch: 92%; letter-spacing: -0.015em; transition: color 0.15s; }
    .hylde-stor:hover .hylde-stor-titel { color: var(--teal-text); }
    .hylde-stor-besk { font-family: var(--font-serif); font-size: 1rem; line-height: 1.55; color: var(--ink-2); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    .hylde-stor-meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); text-transform: uppercase; }
    .hylde-smaa { display: flex; flex-direction: column; }
    .alle-svar { margin-top: 8px; }
    @media (max-width: 860px) {
      .hylde-afsnit-grid { grid-template-columns: minmax(0, 1fr); gap: 8px; }
      .hylde-afsnit-top h2 { font-size: 1.3rem; }
      .hylde-stor-titel { font-size: 1.3rem; }
    }
  </style>

  {/* Toppen (Jacobs valg 29/10, forslag D2): blåt bånd i fuld bredde, overskrift og søgning til venstre,
      de 5 hylder med nyeste svar og antal til højre. Ingen billeder i toppen, så den indlæses hurtigt */}
  <section class="top-d">
    <div class="top-d-indre">
      <div class="top-d-tekst">
        <h1 class="top-d-titel">Clear answers to the tech questions people actually ask.</h1>
        <p class="top-d-sub">Every new page answers one question people search for, short answer first, with the sources named.</p>
        <form class="home-search top-d-sog" action="/search" method="get" role="search">
          <label for="homeQ" class="sr-only">Search the archive</label>
          <input id="homeQ" name="q" type="search" placeholder="Ask a question" autocomplete="off" />
          <button type="submit">Search</button>
        </form>
        <p class="top-d-hvordan">{INDLAEG.length} articles on five shelves. Short answer first, sources named. <a href="/p/editorial-guidelines">How we work</a></p>
      </div>
      <nav class="top-d-reol" aria-label="Shelves">
        {HYLDER.map((h, i) => { const liste = hyldeSorteret(h); return (
          <a href={hyldeUrl(h)} class="top-d-hylde" style={`--h: ${h.farve}; --i: ${i}`}>
            <span class="top-d-ikon" aria-hidden="true"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d={h.ikon} /></svg></span>
            <span class="top-d-navn">{h.navn}{liste[0] && <span class="top-d-nyeste">Latest: {liste[0].title}</span>}</span>
            <span class="top-d-antal">{liste.length}<span>articles</span></span>
          </a>
        ); })}
      </nav>
    </div>
  </section>
  <style is:global>
    .top-d { background: radial-gradient(60% 90% at 85% 20%, #2f4fc4 0%, transparent 70%), linear-gradient(160deg, #142a72 0%, #0f1f55 100%); color: #f3f5ff; margin: 0 0 40px; }
    .top-d-indre { max-width: 1160px; width: calc(100% - 40px); margin: 0 auto; padding: 60px 0 64px; display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 48px; align-items: center; }
    .top-d-tekst { display: flex; flex-direction: column; gap: 18px; }
    .top-d-titel { margin: 0; font-size: clamp(2.3rem, 4.2vw, 3.5rem); line-height: 1.04; font-weight: 700; font-stretch: 88%; letter-spacing: -0.025em; text-wrap: balance; color: #fff; }
    .top-d-sub { margin: 0; font-family: var(--font-serif); font-size: 1.2rem; line-height: 1.55; color: #c9d3ff; max-width: 560px; }
    .top-d-sog input { background: #fff; color: #10182f; border-color: #fff; }
    .top-d-sog button { background: #f2b33d; border-color: #f2b33d; color: #10182f; }
    .top-d-sog input:focus-visible, .top-d-sog button:focus-visible { outline: 2px solid #f2b33d; outline-offset: 2px; }
    .top-d-hvordan { margin: 0; font-size: 15px; color: #aab7f0; }
    .top-d-hvordan a { color: #fff; font-weight: 600; }
    .top-d-reol { display: flex; flex-direction: column; gap: 8px; }
    .top-d-hylde { display: grid; grid-template-columns: 46px minmax(0, 1fr) auto; align-items: center; gap: 14px; padding: 13px 18px 13px 13px; border-radius: var(--radius-lg); text-decoration: none; color: #fff;
      background: rgb(255 255 255 / 7%); border: 1px solid rgb(255 255 255 / 14%);
      margin-left: calc(var(--i) * 14px); transition: transform 0.2s ease, background 0.2s ease, border-color 0.2s ease;
      animation: top-d-ind 0.5s cubic-bezier(.2,.7,.2,1) backwards; animation-delay: calc(var(--i) * 70ms); }
    @keyframes top-d-ind { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
    .top-d-hylde:hover { transform: translateX(-6px); background: rgb(255 255 255 / 13%); border-color: color-mix(in srgb, var(--h) 70%, #fff); }
    .top-d-hylde:focus-visible { outline: 2px solid #f2b33d; outline-offset: 2px; }
    .top-d-ikon { width: 46px; height: 46px; border-radius: 12px; background: var(--h); color: #fff; display: inline-flex; align-items: center; justify-content: center; }
    .top-d-navn { display: flex; flex-direction: column; gap: 3px; min-width: 0; font-weight: 700; font-size: 1.08rem; line-height: 1.2; }
    .top-d-nyeste { font-family: var(--font-serif); font-weight: 400; font-size: 0.88rem; color: #b9c5f5; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .top-d-antal { display: flex; flex-direction: column; align-items: flex-end; font-size: 1.5rem; line-height: 1; font-weight: 700; font-stretch: 88%; color: #fff; }
    .top-d-antal span { font-size: 0.7rem; font-weight: 500; font-stretch: 100%; color: #aab7f0; margin-top: 3px; }
    /* Topbjælken får en tynd blå kant forneden, så den hænger sammen med båndet (kun på forsiden) */
    .top-navbar { border-bottom: 2px solid #2f4fc4; }
    @media (max-width: 900px) {
      .top-d-indre { grid-template-columns: minmax(0, 1fr); width: calc(100% - 30px); padding: 34px 0 30px; gap: 26px; }
      .top-d-titel { font-size: 2.2rem; }
      .top-d-sub { font-size: 1.05rem; }
      .top-d-hylde { margin-left: 0; grid-template-columns: 40px minmax(0, 1fr) auto; padding: 10px 14px 10px 10px; }
      .top-d-ikon { width: 40px; height: 40px; }
    }
    @media (prefers-reduced-motion: reduce) { .top-d-hylde { animation: none; } .top-d-hylde:hover { transform: none; } }
  </style>

  <div class="page-wrapper">

    {hoved && (
      <section class="lead-section" aria-label="Latest">
        <a href={hoved.href} class="lead-card" style={maerke(hoved) ? `--tag-accent: ${maerke(hoved)!.farve}` : undefined}>
          {hoved.image ? <div class="card-thumb"><img src={hoved.image} alt="" loading="eager" fetchpriority="high" /></div> : null}
          {maerke(hoved) && <span class="lead-eyebrow">{maerke(hoved)!.navn}</span>}
          <h2 class="lead-title">{hoved.title}</h2>
          <p class="lead-excerpt">{udsnit(hoved.description, 230)}</p>
          <p class="card-meta"><span>{datoTekst(hoved.published)}</span><span aria-hidden="true">·</span><span>{hoved.minutter} min read</span></p>
        </a>
        <div class="lead-secondary">
          {sideHistorier.map((p) => (
            <a href={p.href} class="lead-mini" style={maerke(p) ? `--tag-accent: ${maerke(p)!.farve}` : undefined}>
              {p.image ? <div class="card-thumb"><img src={p.image} alt="" loading="lazy" /></div> : <div class="card-thumb card-thumb-empty"></div>}
              <div>
                {/* Mærke over titlen (Jacob 5/10-2026), som på hovedhistorien — fra 28/10 hylden i stedet for emnet */}
                {maerke(p) && <span class="lead-eyebrow lead-mini-eyebrow">{maerke(p)!.navn}</span>}
                <h3 class="lead-mini-title">{p.title}</h3>
                <p class="card-meta"><span>{datoTekst(p.published)}</span></p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}

    {sporgsmaal.length > 0 && (
      <section class="home-questions" aria-labelledby="home-questions-heading">
        <div class="section-heading">
          <h2 id="home-questions-heading">Questions people are asking</h2>
          <span class="section-note">{denneUge ? 'Real Google searches, answered this week.' : 'Real Google searches, answered recently.'}</span>
        </div>
        <ul class="home-questions-list">
          {sporgsmaal.map((q) => (
            <li>
              <a href={q.href} class="home-question">
                <span class="home-question-mark" style={`--tag-accent: ${q.farve}; color: ${q.tegn}`} aria-hidden="true">?</span>
                <span class="home-question-text">{q.tekst}</span>
                <span class="home-question-arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Forslag 2 (Jacob 28/10): ét afsnit pr. hylde */}
    {hyldeAfsnit.map(({ h, antal, stor, smaa }) => (
      <section class="hylde-afsnit" style={`--h: ${h.farve}`} aria-labelledby={`afsnit-${h.slug}`}>
        <div class="hylde-afsnit-top">
          <h2 id={`afsnit-${h.slug}`}><a href={hyldeUrl(h)}>{h.navn}</a></h2>
          <a href={hyldeUrl(h)} class="hylde-afsnit-alle">See all {antal} →</a>
        </div>
        <div class="hylde-afsnit-grid">
          <a href={stor.href} class="hylde-stor">
            {stor.image && <img src={stor.image} alt="" loading="lazy" decoding="async" />}
            <span class="hylde-stor-titel">{stor.title}</span>
            {stor.description && <span class="hylde-stor-besk">{stor.description}</span>}
            <span class="hylde-stor-meta">{datoTekst(stor.published)} · {stor.minutter} min read</span>
          </a>
          <div class="hylde-smaa">{smaa.map((p) => <ArtikelRaekke p={p} besk={false} hylde={false} lille />)}</div>
        </div>
      </section>
    ))}

    <div class="section-heading alle-svar"><h2>All answers</h2><span class="section-note">{INDLAEG.length} answers, newest first</span></div>
    <Pagination side={1} antal={antalSider} />
  </div>
</MainLayout>
