---
// Artikelsiden. Adressen er præcis Bloggers: /2026/06/navn.
// Opbygningen følger techfeedwatchs artikelside (brødkrumme, byline, handlinger,
// emne-chips, indholdsfortegnelse, brødtekst, del-boks, forfatter/udgiver,
// forrige/næste, relaterede) — uden videoafspilleren og alt det, der hørte til den.
import MainLayout from '../../../layouts/MainLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { INDLAEG, datoTekst } from '../../../lib/indhold';
import { emneUrl } from '../../../lib/emner';
import Maerke from '../../../components/Maerke.astro';
import { faqSchema } from '../../../lib/faqschema.mjs';
import { ogsaaSpurgt } from '../../../lib/ogsaaspurgt.mjs';
import { tegnFarve } from '../../../lib/sporgsmaal.mjs';
import OGSAA_SPURGT from '../../../../robot/data/ogsaa-spurgt.json';
import MEST_RAA from '../../../../robot/data/mest-laest.json';
import { efterFoersteBillede, foranMidterOverskrift, indsaet } from '../../../lib/artikelbokse.mjs';

export function getStaticPaths() {
  return INDLAEG.map((p) => ({ params: { year: p.aar, month: p.maaned, slug: p.navn }, props: { p } }));
}
const { p } = Astro.props;
const SITE = 'https://www.techmediaarch.com';
const emne = p.emner[0];
// Artikler under menupunktet Resources (etiketten Resources) får affiliate-oplysningen øverst
const erResources = p.labels.includes('Resources');

// "Updated" vises kun, når indlægget reelt er ændret senere (mere end et døgn efter)
const opdateret = new Date(p.updated).getTime() - new Date(p.published).getTime() > 86400000;

// "People also ask" (29/9, Jacob): 3 spørgsmål besvaret i andre artikler, lige over FAQ-boksen (ellers nederst i teksten).
// Boksen er mærket data-ekstra, så tjek-site ser bort fra den, når brødteksten bevises ord for ord mod Blogger.
const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
// Geminis valg (robot/ogsaa-spurgt.mjs, gemt af robotten) bruges, når det findes — også når Gemini valgte ingen.
// Ellers sitets egen ordsammenligning. Et valg, der peger på en artikel, som ikke findes mere, springes over.
const geminiValg = (OGSAA_SPURGT as Record<string, { valg: { q: string; sti: string }[] }>)[p.sti];
const paa = geminiValg
  ? geminiValg.valg.map((v) => { const a = INDLAEG.find((x) => x.sti === v.sti); return a ? { q: v.q, href: a.href, farve: a.emner[0]?.farve || '#0891b2' } : null; }).filter(Boolean).slice(0, 3) as { q: string; href: string; farve: string }[]
  : ogsaaSpurgt(p, INDLAEG, 3);
// Uden <ul>/<li>: Googles Auto-annoncer satte en annonceplads ind MELLEM listepunkterne (målt live 29/9: 280 px hul i boksen).
// Linkene står derfor i én <nav> uden listepunkter; overskrift og undertekst som <span>, så der ikke er afsnit at sætte ind mellem.
const paaHtml = paa.length ? `<aside class="paa" data-ekstra="1" aria-labelledby="paa-heading"><span class="paa-title" id="paa-heading">People also ask</span><span class="paa-sub">Related questions answered on this site.</span><nav class="paa-list" aria-label="People also ask">${
  paa.map((q) => `<a href="${esc(q.href)}" class="paa-link"><span class="paa-mark" style="--tag-accent: ${q.farve}; color: ${tegnFarve(q.farve)}" aria-hidden="true">?</span><span class="paa-text">${esc(q.q)}</span><span class="paa-arrow" aria-hidden="true">→</span></a>`).join('')
}</nav></aside>` : '';
const faqStart = p.html.indexOf('<section class="faq-box"');

const i = INDLAEG.indexOf(p);
const nyere = INDLAEG[i - 1];
const aeldre = INDLAEG[i + 1];

// Relaterede: samme emne først, derefter de nyeste; aldrig artiklen selv
const somEmne = emne ? INDLAEG.filter((x) => x !== p && x.emner.some((e) => e.slug === emne.slug)) : [];

// "You might also like" (1/10, Jacob): 2 forslag midt i artiklen. Samme emne først, de mest læste (Analytics, 7 dage)
// først, kun artikler med billede, og ikke dem, "People also ask" allerede peger på. De to står så ikke igen i Related.
const paaHref = new Set(paa.map((q) => q.href));
const laest = (x: typeof p) => (MEST_RAA as { sider?: Record<string, { visninger: number }> }).sider?.[x.sti]?.visninger ?? 0;
const kandidater = [...somEmne, ...INDLAEG.filter((x) => x !== p && !somEmne.includes(x))].filter((x) => x.image && !paaHref.has(x.href));
// Samme emne vinder altid over et andet emne (målt 1/10: en Product-artikel fik ellers et Infosec-forslag, fordi det var læst mest)
const sammeEmne = (x: typeof p) => (somEmne.includes(x) ? 1 : 0);
const forslag = [...kandidater.slice(0, 12)].sort((a, b) => sammeEmne(b) - sammeEmne(a) || laest(b) - laest(a)).slice(0, 2);
const forslagHtml = forslag.length === 2 ? `<aside class="ymal" data-ekstra="1" aria-label="You might also like"><span class="ymal-label">You might also like</span><span class="ymal-grid">${
  forslag.map((x) => `<a href="${esc(x.href)}" class="ymal-card"><span class="ymal-thumb"><img src="${esc(x.image!)}" alt="" loading="lazy" decoding="async"></span><span class="ymal-title">${esc(x.title)}</span></a>`).join('')
}</span></aside>` : '';
const relaterede = [...somEmne, ...INDLAEG.filter((x) => x !== p && !somEmne.includes(x))].filter((x) => !forslag.includes(x)).slice(0, 8);
// Sidebaren lover "More in <emne>" — så den må kun vise det emne. Har emnet
// for få artikler, hedder den "Latest articles" og viser de nyeste i stedet.
const nokIEmne = somEmne.length >= 3;
const sidebarTitel = nokIEmne ? `More in ${emne!.navn}` : 'Latest articles';
const sidebarListe = (nokIEmne ? somEmne : INDLAEG.filter((x) => x !== p)).slice(0, 8);

// Indholdsfortegnelse ved 3+ overskrifter. Bliver den lang (de ældre indlæg har
// op til 40), vises kun hovedafsnittene (h2), så den ikke fylder en hel skærm.
const toc = p.overskrifter.length < 3 ? [] : p.overskrifter.length > 14 ? p.overskrifter.filter((h) => h.niveau === 2) : p.overskrifter;
// 1/10 (Jacob: "det skal være under billedet"): fortegnelsen står i brødteksten lige under det første billede
// (ellers øverst). Uden <ul>/<li>, så Auto-annoncer ikke sætter annoncer ind mellem punkterne (som i People also ask).
const tocHtml = toc.length ? `<nav class="toc-container" data-ekstra="1" aria-label="Table of contents"><span class="toc-title">Table of Contents</span><span class="toc-list">${
  toc.map((h) => `<a class="toc-depth-${h.niveau}" href="#${esc(h.id)}">${esc(h.tekst)}</a>`).join('')
}</span></nav>` : '';
const slut = faqStart >= 0 ? faqStart : p.html.length;
const broedtekst = indsaet(p.html, [
  { pos: efterFoersteBillede(p.html, slut), html: tocHtml },
  { pos: foranMidterOverskrift(p.html, slut), html: forslagHtml },
  { pos: slut, html: paaHtml },
]);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  // Google godtager højst 110 tegn i headline — længere titler bruger søgetitlen
  headline: p.title.length > 110 ? p.seoTitle : p.title,
  description: p.description,
  datePublished: p.published,
  dateModified: p.updated,
  mainEntityOfPage: SITE + p.href,
  ...(p.image ? { image: SITE + p.image } : {}),
  // Forfatter = en navngiven person (Jacobs valg 27/9-2026): Google og AI-tjenester vægter,
  // at der står et menneske bag. Navn og titel som på om-siden ("Jacob Olsen Founder & CEO").
  author: { '@type': 'Person', name: 'Jacob Olsen', jobTitle: 'Founder & CEO', url: SITE + '/p/about-us', worksFor: { '@id': `${SITE}/#organization` } },
  publisher: { '@type': 'Organization', name: 'Tech Media Arch', url: SITE + '/', logo: { '@type': 'ImageObject', url: SITE + '/icon-512.png' } },
  ...(p.labels.length ? { keywords: p.labels.join(', ') } : {}),
};
// FAQ-data som Blogger-temaet lavede dem (se lib/faqschema.mjs) + de ekstra spørgsmål fra frontmatter,
// så Google får præcis de spørgsmål, læseren ser i FAQ-boksen
const egneFaq = faqSchema(p.faqHtml);
const ekstraQ = p.faqEkstra.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: x.a } }));
const faq = egneFaq || ekstraQ.length ? { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: [...(egneFaq?.mainEntity || []), ...ekstraQ] } : null;
const crumbs = emne ? [{ navn: emne.navn, href: emneUrl(emne) }, { navn: p.title, href: p.href }] : [{ navn: p.title, href: p.href }];
---
<MainLayout title={p.title} seoTitle={p.seoTitle} description={p.description} image={p.image} schema={faq ? [schema, faq] : schema} ogType="article" breadcrumb={crumbs}>
  <style is:global>
    .article-layout { display: flex; gap: 25px; max-width: 1200px; margin: 0 auto; padding: 30px 20px; box-sizing: border-box; align-items: flex-start; width: 100%; }
    .article-primary { flex: 1; min-width: 0; width: 100%; max-width: 100%; }
    .article-secondary { width: 340px; flex-shrink: 0; position: sticky; top: 80px; max-height: calc(100vh - 100px); /* top: 60 px topbar + 20 px luft (siden ruller i vinduet fra 29/9) */ overflow-y: auto; padding-right: 8px; scrollbar-width: thin; scrollbar-color: var(--border-color) transparent; }
    .breadcrumbs-bar { background: var(--hover-bg); padding: 0 18px; border-radius: 8px; font-size: 0.9rem; margin-bottom: 20px; color: var(--muted); display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--border-color); flex-wrap: wrap; }
    .breadcrumbs-bar a { color: var(--teal-text); text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; min-height: 44px; padding: 0 2px; }
    .article-title { margin: 0 0 15px 0; font-size: 2rem; line-height: 1.2; }
    /* FAQ-boksen (lib/faqboks.mjs): spørgsmålene kan foldes ud; svaret står i HTML'en, så Google og AI læser det */
    /* People also ask (29/9) — samme udseende som på Jacobs andet site; nulstiller brødtekstens link- og listestil */
    /* 30/9 (Jacobs valg A): boksen flød ind i teksten. Nu tyk turkis kant i venstre side og en let turkis tone,
       samme stil som forklaringsboksen på Best of each topic — også i mørk tilstand (tonen blandes med kortfarven) */
    .post-body .paa { margin: 32px 0 10px; padding: 22px 24px; background: color-mix(in srgb, var(--teal) 9%, var(--card-bg)); border: 1px solid color-mix(in srgb, var(--teal) 35%, var(--border-color)); border-left: 5px solid var(--teal); border-radius: 14px; }
    .post-body .paa-title { display: flex; align-items: center; gap: 8px; margin: 0 0 4px; font-size: 1.1rem; font-weight: 800; letter-spacing: -0.01em; line-height: 1.3; }
    /* Lille turkis "?" foran titlen (pseudo-element: ingen ekstra tags, som Auto-annoncer kan hæfte sig på) */
    .post-body .paa-title::before { content: '?'; flex: none; width: 22px; height: 22px; border-radius: 50%; background: #0e7490; color: #fff; font-size: 0.8rem; font-weight: 800; display: inline-flex; align-items: center; justify-content: center; }
    /* #4b5563 på den turkise tone giver over 4,5:1 (#6b7280 gav ca. 4,4:1) */
    .post-body .paa-sub { display: block; margin: 0 0 14px; font-size: 0.85rem; color: #4b5563; line-height: 1.4; }
    body.dark-mode .post-body .paa-sub { color: #9ca3af; }
    .post-body .paa-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
    .post-body .paa-list li { margin: 0; }
    .post-body a.paa-link { display: flex; align-items: center; gap: 12px; padding: 9px 10px; min-height: 44px; box-sizing: border-box; border-radius: 10px; text-decoration: none; color: var(--text-color); font-weight: 400; border: 1px solid transparent; transition: background 0.2s, border-color 0.2s, transform 0.2s; }
    .post-body a.paa-link:hover { background: var(--card-bg); border-color: var(--border-color); transform: translateX(3px); }
    .post-body .paa-mark { flex: none; width: 26px; height: 26px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; font-size: 0.85rem; background: var(--tag-accent); }
    .post-body .paa-text { font-weight: 600; font-size: 0.95rem; line-height: 1.35; }
    .post-body .paa-arrow { margin-left: auto; color: #9ca3af; transition: transform 0.15s, color 0.2s; }
    .post-body a.paa-link:hover .paa-arrow { transform: translateX(3px); color: var(--teal-text); }
    @media (prefers-reduced-motion: reduce) { .post-body a.paa-link:hover, .post-body a.paa-link:hover .paa-arrow { transform: none; } }
    @media (max-width: 900px) { .post-body .paa { padding: 16px 14px; } }
    .post-body .faq-box { background: var(--hover-bg); border: 1px solid var(--border-color); border-radius: 12px; padding: 6px 20px 10px; margin: 32px 0; }
    .post-body .faq-box > h2 { margin: 14px 0 6px; }
    /* Hvert spørgsmål er et kort — rammen kommer fra den fælles .post-body details-regel i MainLayout */
    .post-body .faq-box .faq-item { background: var(--card-bg); margin: 10px 0; }
    .post-body .faq-item > summary { list-style: none; cursor: pointer; position: relative; padding: 14px 34px 14px 0; font-weight: 600; font-size: 1.02rem; line-height: 1.45; min-height: 24px; }
    .post-body .faq-item > summary::-webkit-details-marker { display: none; }
    .post-body .faq-item > summary::after { content: '+'; position: absolute; right: 6px; top: 50%; transform: translateY(-50%); font-size: 1.4rem; font-weight: 400; color: var(--teal-text); }
    .post-body .faq-item[open] > summary::after { content: '\2212'; }
    .post-body .faq-answer { padding: 0 0 12px; }
    .post-body .faq-answer > :first-child { margin-top: 0; }
    .article-byline { display: flex; align-items: center; gap: 12px; margin: 0 0 18px 0; }
    .byline-avatar { width: 40px; height: 40px; border-radius: 50%; flex-shrink: 0; background: var(--hover-bg); border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: center; }
    .byline-avatar svg { width: 24px; height: auto; }
    .byline-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .byline-name { font-size: 0.92rem; font-weight: 600; }
    .byline-name a { color: inherit; text-decoration: none; }
    .byline-name a:hover { text-decoration: underline; }
    .byline-meta { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; font-size: 0.83rem; color: var(--muted); font-weight: 500; }
    .meta-sep { opacity: 0.5; }
    .action-bar { display: flex; gap: 10px; margin-bottom: 22px; align-items: center; flex-wrap: wrap; }
    .action-pill { display: inline-flex; align-items: center; gap: 6px; background: var(--hover-bg); border-radius: 20px; height: 40px; padding: 0 16px; border: 1px solid var(--border-color); color: var(--text-color); font-size: 0.9rem; font-weight: 600; cursor: pointer; font-family: inherit; transition: background 0.2s; }
    .action-pill:hover { background: #e2e8f0; }
    body.dark-mode .action-pill:hover { background: #334155; }
    .action-icon { width: 18px; height: 18px; }
    .tag-container { margin-bottom: 25px; display: flex; flex-wrap: wrap; gap: 8px; }
    .tag-badge { display: inline-flex; align-items: center; gap: 6px; background-color: #e2e8f0; color: #334155; padding: 5px 14px; min-height: 32px; box-sizing: border-box; border-radius: 20px; font-size: 0.85rem; font-weight: 600; text-decoration: none; transition: all 0.2s ease; }
    .tag-badge::before { content: ''; width: 7px; height: 7px; border-radius: 50%; background: var(--tag-accent); }
    body.dark-mode .tag-badge { background-color: #27272a; color: #d4d4d8; }
    .tag-badge:hover { background-color: #cbd5e1; color: #0f172a; transform: translateY(-1px); }
    /* Indholdsfortegnelsen står fra 1/10 INDE i brødteksten under første billede (lib/artikelbokse.mjs) — uden ul/li,
       så punkterne er <a> i en <span>. Reglerne er knyttet til .post-body, så de vinder over brødtekstens linkstil. */
    .post-body .toc-container { display: block; background: var(--hover-bg); border-radius: 8px; padding: 20px; margin: 26px 0 30px; border: 1px solid var(--border-color); }
    .post-body .toc-title { display: block; font-weight: bold; margin-bottom: 12px; font-size: 1.1rem; }
    .post-body .toc-list { display: flex; flex-direction: column; gap: 2px; }
    .post-body .toc-list a { display: block; padding: 4px 0; color: var(--text-color); text-decoration: none; font-weight: 500; border-bottom: 0; line-height: 1.45; }
    .post-body .toc-list a:hover { color: var(--teal-text); border-bottom: 0; }
    .post-body .toc-list a.toc-depth-3 { padding-left: 20px; font-size: 0.95rem; opacity: 0.9; }
    /* "You might also like" (1/10, som på techfeedwatch): 2 forslag midt i artiklen. Kun <span>/<a>, ingen afsnit. */
    .post-body .ymal { display: block; margin: 30px 0; padding: 20px 22px 22px; background: var(--hover-bg); border: 1px solid var(--border-color); border-radius: 14px; }
    .post-body .ymal-label { display: flex; align-items: center; gap: 8px; margin: 0 0 14px; font-size: 0.85rem; font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: var(--muted); }
    .post-body .ymal-label::before { content: '🔎'; letter-spacing: 0; }
    .post-body .ymal-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
    .post-body a.ymal-card { display: block; color: var(--teal-text); font-weight: 700; border-bottom: 0; text-decoration: none; }
    .post-body a.ymal-card:hover { border-bottom: 0; }
    .post-body .ymal-thumb { display: block; aspect-ratio: 16/9; overflow: hidden; border-radius: 10px; margin-bottom: 10px; background: var(--border-color); }
    .post-body .ymal-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 0; margin: 0; transition: transform 0.3s; }
    .post-body a.ymal-card:hover .ymal-thumb img { transform: scale(1.04); }
    .post-body .ymal-title { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; font-size: 1rem; line-height: 1.4; }
    .post-body a.ymal-card:hover .ymal-title { text-decoration: underline; }
    @media (max-width: 600px) { .post-body .ymal { padding: 16px 14px; } .post-body .ymal-grid { gap: 12px; } .post-body .ymal-title { font-size: 0.92rem; } }
    @media (prefers-reduced-motion: reduce) { .post-body a.ymal-card:hover .ymal-thumb img { transform: none; } }
    .disclosure-box { font-size: 0.85rem; line-height: 1.6; color: var(--muted); background: var(--hover-bg); border: 1px solid var(--border-color); border-radius: 10px; padding: 14px 18px; margin: 0 0 30px 0; }
    .disclosure-box strong { color: var(--text-color); }
    .disclosure-box a { color: var(--teal-text); font-weight: 600; }
    .disclosure-top { margin: 0 0 25px 0; }
    .share-cta { display: flex; align-items: center; justify-content: space-between; gap: 20px; background: var(--hover-bg); border: 1px solid var(--border-color); border-radius: 10px; padding: 20px 24px; margin-bottom: 40px; }
    .share-cta-title { font-weight: 700; font-size: 1.05rem; margin: 0 0 4px 0; }
    .share-cta-sub { font-size: 0.9rem; color: var(--muted); margin: 0; }
    .share-cta-btn { display: inline-flex; align-items: center; gap: 8px; background: #0e7490; color: #fff; border: none; border-radius: 8px; padding: 11px 20px; min-height: 44px; font-size: 0.95rem; font-weight: 600; cursor: pointer; flex-shrink: 0; font-family: inherit; transition: background 0.2s, transform 0.2s; }
    .share-cta-btn:hover { background: #155e75; transform: translateY(-1px); }
    .share-cta-btn svg { width: 16px; height: 16px; }
    /* Forfatterboks (29/9, Jacobs ønske): samme udseende som på techfeedwatch, egen tekst til Tech Media Arch */
    .author-box { display: flex; gap: 20px; align-items: flex-start; width: 100%; box-sizing: border-box; background: var(--hover-bg); border: 1px solid var(--border-color); border-left: 4px solid #0891b2; border-radius: 10px; padding: 28px; margin: 10px 0 30px; }
    .author-box-photo { width: 80px; height: 80px; border-radius: 50%; object-fit: cover; object-position: center top; flex-shrink: 0; }
    .author-box-name { font-weight: 700; font-size: 1.15rem; margin: 0; }
    .author-box-title { font-size: 0.9rem; font-weight: 600; color: var(--teal-text); margin: 4px 0 14px 0; }
    body.dark-mode .author-box-title { color: #22d3ee; }
    .author-box-bio { font-size: 1rem; line-height: 1.7; margin: 0 0 16px 0; }
    .author-box-ai-note { font-size: 0.82rem; font-style: italic; color: #6b7280; margin: 0; padding-top: 16px; margin-top: 4px; border-top: 1px solid var(--border-color); }
    body.dark-mode .author-box-ai-note { color: #9ca3af; }
    .author-box-ai-note a { color: var(--teal-text); text-decoration: none; font-weight: 600; font-style: normal; }
    .author-box-ai-note a:hover { text-decoration: underline; }
    .nav-row { display: flex; gap: 20px; border-top: 1px solid var(--border-color); padding-top: 25px; margin-bottom: 40px; }
    .nav-card { flex: 1; background: var(--card-bg); border: 2px solid var(--border-color); padding: 15px 20px; border-radius: 8px; text-decoration: none; color: var(--text-color); transition: all 0.2s ease; display: flex; flex-direction: column; gap: 5px; box-sizing: border-box; overflow: hidden; min-width: 0; }
    .nav-card:hover { transform: translateY(-3px); border-color: var(--teal-text); box-shadow: 0 6px 24px rgba(0,0,0,0.06); }
    .nav-card.right { text-align: right; }
    .nav-label { font-size: 0.8rem; color: var(--teal-text); font-weight: bold; text-transform: uppercase; letter-spacing: 0.5px; }
    .nav-title { font-size: 1rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .nav-card.disabled { opacity: 0.4; pointer-events: none; }
    /* Related articles i en samlet boks (30/9, Jacob): uden overskrift-tag og uden <p>, så Googles Auto-annoncer
       ikke sætter annoncer ind mellem kortene — samme løsning som "People also ask" */
    .related-box { background: var(--card-bg); border: 1px solid var(--border-color); border-radius: 14px; padding: 18px 20px 20px; margin-top: 10px; }
    .related-articles-title { display: block; font-size: 1.4rem; font-weight: 700; margin: 0 0 18px 0; padding-bottom: 10px; border-bottom: 2px solid var(--border-color); }
    .related-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 18px; }
    .related-grid .card-excerpt { display: none; }
    /* Titlen er et <span> (ikke h3), så fed skrift sættes her. Læsetiden skjules i de smalle kort: den brød ud på en
       ny linje med en løs "·" for enden (målt 30/9, desktop og mobil) */
    .related-grid .card-title { font-weight: 700; }
    .related-grid .card-meta > :nth-last-child(-n+2) { display: none; }
    .side-title { font-size: 1.1rem; margin: 0 0 15px 0; }
    .side-list { display: flex; flex-direction: column; gap: 14px; }
    .side-item { display: grid; grid-template-columns: 130px 1fr; gap: 12px; text-decoration: none; color: inherit; align-items: start; }
    .side-item .card-thumb { margin: 0; border-radius: 8px; }
    .side-item-title { font-size: 14px; line-height: 1.4; font-weight: 600; margin: 0; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .side-item:hover .side-item-title { color: var(--teal-text); }
    @media (max-width: 900px) {
      .article-layout { flex-direction: column; padding: 15px 12px; }
      .article-secondary { width: 100%; position: static; max-height: none; overflow: visible; padding-right: 0; }
      .article-title { font-size: 1.5rem; }
      .nav-row { flex-direction: column; gap: 12px; }
      .share-cta { flex-direction: column; align-items: flex-start; }
      .share-cta-btn { width: 100%; justify-content: center; }
      .author-box { padding: 18px; gap: 12px; flex-direction: column; align-items: flex-start; }
      .author-box-photo { width: 56px; height: 56px; }
      .author-box-name { font-size: 1.05rem; }
      .author-box-title { font-size: 0.85rem; margin: 3px 0 12px 0; }
      .author-box-bio { font-size: 0.92rem; line-height: 1.6; margin-bottom: 12px; }
      .author-box-ai-note { font-size: 0.78rem; padding-top: 12px; }
      .related-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
      .related-box { padding: 14px 12px 16px; }
    }
  </style>

  <div class="article-layout">
    <div class="article-primary">
      <nav class="breadcrumbs-bar" aria-label="Breadcrumb">
        <a href="/">Frontpage</a>
        {emne && <><span>/</span><a href={emneUrl(emne)}>{emne.navn}</a></>}
      </nav>

      <h1 class="article-title">{p.title}</h1>

      <div class="article-byline">
        <span class="byline-avatar" aria-hidden="true"><Maerke id="by" /></span>
        <div class="byline-text">
          <span class="byline-name">Published by <a href="/p/about-us" rel="author">Jacob Olsen</a></span>
          <span class="byline-meta">
            <time datetime={p.published}>{datoTekst(p.published)}</time>
            {opdateret && <><span class="meta-sep">·</span><span>Updated <time datetime={p.updated}>{datoTekst(p.updated)}</time></span></>}
            <span class="meta-sep">·</span><span>{p.minutter} min read</span>
          </span>
        </div>
      </div>

      <div class="action-bar">
        <button type="button" class="action-pill share-trigger" aria-label="Share this article">
          <svg class="action-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
          <span class="share-text">Share</span>
        </button>
      </div>

      {p.emner.length > 0 && (
        <div class="tag-container">
          {p.emner.map((e) => <a href={emneUrl(e)} class="tag-badge" style={`--tag-accent: ${e.farve}`}>{e.navn}</a>)}
        </div>
      )}

      {/* Resources-artikler har affiliate-/henvisningslinks: oplysningen skal stå FØR linkene,
          ikke kun nederst (Jacob 28/9). Gælder også fremtidige artikler med etiketten Resources. */}
      {erResources && (
        <p class="disclosure-box disclosure-top"><strong>Affiliate disclosure:</strong> This article contains affiliate or referral links. If you sign up or buy through them, Tech Media Arch may earn a commission at no extra cost to you. Partners cannot pay for a positive review, and nothing here is financial or investment advice. Read our full <a href="/p/disclosure">Disclosure</a>.</p>
      )}

      <article class="post-body" set:html={broedtekst} />

      {/* Stod før som fodnote i hvert indlæg (Blogger-feedets fodnote). Resources-artikler har den øverst i stedet. */}
      {!erResources && <p class="disclosure-box"><strong>Affiliate disclosure:</strong> Please note that some links on TechMediaArch.com are affiliate links. We may receive a commission, at no extra cost to you, if you click through our links and make a purchase from one of our partners.</p>}

      <div class="share-cta">
        <div>
          <p class="share-cta-title">Share this article</p>
          <p class="share-cta-sub">Send it to someone who follows AI and tech, or save the link for later.</p>
        </div>
        <button type="button" class="share-cta-btn share-trigger" aria-label="Share this article">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
          <span class="share-text">Share</span>
        </button>
      </div>

      {/* Forfatterboks (29/9): teksten skal være sand for artiklens slags — robotartikler og de ældre artikler er lavet forskelligt (Jacob 29/9) */}
      <div class="author-box">
        <img src="/jacob-olsen.png" alt="Jacob S. Olsen" class="author-box-photo" width="80" height="80" loading="lazy" />
        <div>
          <p class="author-box-name">Jacob S. Olsen</p>
          <p class="author-box-title">Runs Tech Media Arch, from Denmark</p>
          {p.robot ? (
            <>
              <p class="author-box-bio">How this article was made: it starts from a question people search for on Google. A language model researches it on the web and writes the article; it is only published if at least two sources check out. It publishes automatically — I do not read every article before it goes live.</p>
              <p class="author-box-ai-note">What is mine is the machinery and the rules it follows: which subjects, which sources, what gets rejected. <a href="/p/about-us">More on that here</a> — and if something is wrong, <a href="/p/contact-us">tell me</a>.</p>
            </>
          ) : (
            <>
              <p class="author-box-bio">How this article was made: I chose the subject myself — one main phrase people search for on Google and five related ones — and the article was written to answer them.</p>
              <p class="author-box-ai-note">What is mine is the choice of subject and of the search phrases the article answers. <a href="/p/about-us">More about Tech Media Arch</a> — and if something is wrong, <a href="/p/contact-us">tell me</a>.</p>
            </>
          )}
        </div>
      </div>

      <div class="nav-row">
        <a href={aeldre ? aeldre.href : '#'} class={`nav-card ${aeldre ? '' : 'disabled'}`}>
          <span class="nav-label">← Previous article</span>
          <span class="nav-title">{aeldre ? aeldre.title : 'No older articles'}</span>
        </a>
        <a href={nyere ? nyere.href : '#'} class={`nav-card right ${nyere ? '' : 'disabled'}`}>
          <span class="nav-label">Next article →</span>
          <span class="nav-title">{nyere ? nyere.title : 'No newer articles'}</span>
        </a>
      </div>

      {relaterede.length > 0 && (
        <section class="related-box" aria-labelledby="related-heading">
          <span class="related-articles-title" id="related-heading">Related articles</span>
          <div class="related-grid">{relaterede.map((r) => <ArticleCard p={r} udenAnkre udenUdsnit />)}</div>
        </section>
      )}
    </div>

    {sidebarListe.length > 0 && (
      <aside class="article-secondary" aria-label="More articles">
        <h2 class="side-title">{sidebarTitel}</h2>
        <div class="side-list">
          {sidebarListe.map((r) => (
            <a href={r.href} class="side-item">
              {r.image ? <div class="card-thumb"><img src={r.image} alt="" loading="lazy" /></div> : <div class="card-thumb card-thumb-empty"></div>}
              <h3 class="side-item-title">{r.title}</h3>
            </a>
          ))}
        </div>
      </aside>
    )}
  </div>

  {/* Del-knapper: telefonens egen del-menu når den findes, ellers kopieres linket. */}
  <script is:inline>
    document.querySelectorAll('.share-trigger').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var data = { title: document.title, url: location.href };
        if (navigator.share) { navigator.share(data).catch(function () {}); return; }
        var label = btn.querySelector('.share-text');
        var done = function () { if (label) { var old = label.textContent; label.textContent = 'Link copied'; setTimeout(function () { label.textContent = old; }, 2000); } };
        if (navigator.clipboard) navigator.clipboard.writeText(location.href).then(done).catch(function () {});
      });
    });
  </script>
</MainLayout>
