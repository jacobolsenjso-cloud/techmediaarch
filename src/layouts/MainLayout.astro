            Other topics
            <svg class="nav-topics-pil" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6"/></svg>
          </summary>
          {ANDRE_EMNER.map((e) => (
            <a href={emneUrl(e)} class={`nav-item ${aktiv(emneUrl(e)) ? 'active' : ''}`} style={`--tag-accent: ${e.farve}`}>
              <span class="nav-dot" aria-hidden="true"></span>
