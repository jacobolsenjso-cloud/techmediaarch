    {/* Push-beskeder (appen trin 3, 10/11-2026; som techfeedwatch: højst 1 om dagen). Tegner knappen i alle
        [data-push-felt] (siden /app). iPhone/iPad kan kun få beskeder fra en installeret app (Apples regel), så
        dér vises en vejledning til "Add to Home Screen" i stedet. Tilmeldingen ligger hos tma-push (cloudflare/tma-push):
        kun push-adressen, intet navn, ingen mail, ingen IP. */}
    <script is:inline>
      (function () {
        var API = 'https://tma-push.jacobolsenjso.workers.dev';
        var VAPID = 'BF6qTvgEwd0bz_zmMlFKnlhrdHU6VsrfnspU6iyChKJ-oBpsOQCcqEXKv7VXEFeF42p7GUt16SyNvajeBoLTDn4';
        var laes = function (k) { try { return JSON.parse(localStorage.getItem(k)); } catch (e) { return null; } };
        var skriv = function (k, v) { try { if (v === null) localStorage.removeItem(k); else localStorage.setItem(k, JSON.stringify(v)); } catch (e) {} };
        var maal = function (navn) { if (typeof gtag === 'function') gtag('event', navn, {}); };
        var iOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
        var installeret = window.tmaVisning === 'standalone';
        var kan = 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window;
        var travl = false, fejltekst = '';
        function tilstand() {
          if (iOS && !installeret) return 'ios';
          if (!kan) return 'ikke';
          if (Notification.permission === 'denied') return 'blokeret';
          return laes('tma_push') ? 'til' : 'fra';
        }
        function noegle() {
          var s = VAPID.replace(/-/g, '+').replace(/_/g, '/'); s += '='.repeat((4 - s.length % 4) % 4);
          var r = atob(s), u = new Uint8Array(r.length); for (var i = 0; i < r.length; i++) u[i] = r.charCodeAt(i); return u;
        }
        function send(sti, data) {
          return fetch(API + sti, { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) })
            .then(function (r) { if (!r.ok) throw new Error(sti + ' ' + r.status); });
        }
        // Husk hvilken push-adresse tma-push kender, og hvornår (browsere kan skifte adressen)
        function husk(s) { if (s) skriv('tma_push_synk', { ep: s.endpoint, t: Date.now() }); }
        function tilmeld() {
          return Notification.requestPermission().then(function (svar) {
            if (svar !== 'granted') return;
            return window.tmaSw().then(function (reg) {
              return reg.pushManager.getSubscription().then(function (s) { return s || reg.pushManager.subscribe({ userVisibleOnly: true, applicationServerKey: noegle() }); });
            }).then(function (s) {
              return send('/subscribe', { subscription: s.toJSON() }).then(function () { skriv('tma_push', 1); husk(s); maal('push_subscribe'); });
            });
          });
        }
        function afmeld() {
          return window.tmaSw().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (s) {
            if (!s) return;
            return send('/unsubscribe', { endpoint: s.endpoint }).catch(function () {}).then(function () { return s.unsubscribe(); });
          }).then(function () { skriv('tma_push', null); skriv('tma_push_synk', null); maal('push_unsubscribe'); });
        }
        // Fornyer tilmeldingen højst en gang om ugen (tma-push glemmer den efter 180 dage uden besøg)
        function synk() {
          if (!kan || !laes('tma_push') || Notification.permission !== 'granted') return;
          window.tmaSw().then(function (reg) { return reg.pushManager.getSubscription(); }).then(function (s) {
            if (!s) { skriv('tma_push', null); tegn(); return; }
            var sidst = laes('tma_push_synk') || {};
            if (sidst.ep === s.endpoint && Date.now() - (sidst.t || 0) < 7 * 864e5) return;
            return send('/subscribe', { subscription: s.toJSON() }).then(function () { husk(s); });
          }).catch(function () {});
        }
        var TEKST = {
          fra: '<button type="button" class="push-knap" data-push-handling="til">Get a daily notification</button><span class="push-note">At most one a day, when there is a new answer. Turn it off anytime.</span>',
          til: '<span class="push-paa">Daily notification is on</span><button type="button" class="push-link" data-push-handling="fra">Turn off</button>',
          blokeret: '<span class="push-note">Notifications are blocked for this site. Allow them in your browser\'s site settings to get a daily notification.</span>',
          ikke: '<span class="push-note">This browser can\'t show notifications. They work in Chrome, Edge, Firefox and Safari.</span>',
          ios: '<span class="push-note">On iPhone and iPad, Apple only allows notifications from installed apps. Install Tech Media Arch first (see above), open it from your home screen, and come back to this page.</span>',
        };
        function tegn() {
          var t = tilstand(), html = TEKST[t] + (fejltekst ? '<span class="push-fejl" role="alert">' + fejltekst + '</span>' : '');
          document.querySelectorAll('[data-push-felt]').forEach(function (el) { el.innerHTML = html; el.setAttribute('data-push-tilstand', t); el.hidden = false; });
        }
        document.addEventListener('click', function (e) {
          var k = e.target.closest && e.target.closest('[data-push-handling]'); if (!k || travl) return;
          travl = true; fejltekst = ''; k.disabled = true;
          (k.getAttribute('data-push-handling') === 'til' ? tilmeld() : afmeld())
            .catch(function () { fejltekst = 'Something went wrong. Please try again.'; })
            .then(function () { travl = false; tegn(); });
        });
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', tegn); else tegn();
        // Har læseren slået beskeder fra i browseren, ryddes markeringen, så knappen viser det rigtige
        if (kan && laes('tma_push') && Notification.permission !== 'granted') skriv('tma_push', null);
        setTimeout(synk, 6000); // efter siden er færdig — konkurrerer ikke med indholdet
      })();
    </script>

    {/* Tryk-løft på telefon (10/11-2026, Hover 2.0): se CSS'en ved ".tryk". Kun fingre (pointerType "touch") — en mus
        har hover i stedet. Klassen sættes ved første berøring (før klikket), så løftet kan ses, mens næste side hentes;
        navigationen forsinkes IKKE. Bevæger fingeren sig mere end 10 px (rulning), eller afbryder browseren berøringen,
        fjernes klassen straks. Kommer man tilbage med "Tilbage" (siden genskabt fra browserens hukommelse), ryddes den også. */}
    <script is:inline>
      (function () {
        var KORT = '.article-card, .lead-card, .lead-mini, .hylde-stor, .raekke, .hylde-raekke, .side-item, .las-naeste-link, .mega-nyeste, .vej';
        var aktiv = null, x0 = 0, y0 = 0, ur = null, start = null;
        var fjern = function () { clearTimeout(ur); clearTimeout(start); if (aktiv) aktiv.classList.remove('tryk'); aktiv = null; };
        document.addEventListener('pointerdown', function (e) {
          if (e.pointerType !== 'touch' || !e.target.closest) return;
          var k = e.target.closest(KORT); fjern(); if (!k) return;
          aktiv = k; x0 = e.clientX; y0 = e.clientY;
          // 60 ms ventetid: begynder fingeren at rulle, når browseren at melde det (pointercancel/pointermove) først,
          // så kortet ikke blinker op under en rulning. Et tryk varer længere, så løftet ses stadig før sideskiftet.
          start = setTimeout(function () { if (aktiv === k) k.classList.add('tryk'); }, 60);
        }, { passive: true });
        document.addEventListener('pointermove', function (e) {
          if (aktiv && (Math.abs(e.clientX - x0) > 10 || Math.abs(e.clientY - y0) > 10)) fjern();
        }, { passive: true });
        document.addEventListener('pointercancel', fjern, { passive: true });
        // Slipper fingeren uden at siden skifter (fx et kort uden link), lægger kortet sig igen efter et øjeblik
        // Et meget hurtigt tryk (under 60 ms) får stadig løftet: klassen sættes straks, når fingeren slippes
        document.addEventListener('pointerup', function () { if (aktiv) { clearTimeout(start); aktiv.classList.add('tryk'); clearTimeout(ur); ur = setTimeout(fjern, 900); } }, { passive: true });
        window.addEventListener('pageshow', fjern);
        // iOS Safari viser kun berørings-tilstande, når siden lytter efter touchstart
        document.addEventListener('touchstart', function () {}, { passive: true });
      })();
    </script>

    {/* "Cookie settings" åbner Googles egen samtykkedialog igen — vises kun,
        når Googles CMP faktisk er indlæst. */}
    <script is:inline>
      (function () {
        var link = document.getElementById('cookieSettingsLink');
        var sep = document.getElementById('cookieSettingsSep');
        if (!link) return;
        function enable() {
          link.hidden = false; if (sep) sep.hidden = false;
          link.addEventListener('click', function (e) { e.preventDefault(); try { window.googlefc.showRevocationMessage(); } catch (err) {} });
        }
        var tries = 0;
        var t = setInterval(function () {
          if (window.googlefc && typeof window.googlefc.showRevocationMessage === 'function') { clearInterval(t); enable(); }
          // 30 s (1/11-2026): Googles scripts hentes først efter indlæsning + ledig tid, så 10 s kunne være for kort
          else if (++tries > 120) clearInterval(t);
        }, 250);
      })();
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var body = document.body;
        // YouTube: afspilleren hentes først, når læseren klikker (som på Blogger)
        document.addEventListener('click', function (e) {
          var w = e.target.closest && e.target.closest('.yt-lazy');
          if (!w || w.querySelector('iframe')) return;
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube.com/embed/' + encodeURIComponent(w.getAttribute('data-yt')) + '?autoplay=1';
          f.title = 'YouTube video';
          f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
          f.setAttribute('allowfullscreen', 'true');
          w.innerHTML = ''; w.appendChild(f);
        });
        // Mørk tilstand
        var themeBtn = document.getElementById('themeToggle');
        // Ikonet (måne/sol) skiftes af CSS'en ud fra body.dark-mode; her opdateres kun knappens tekst til skærmlæsere
        var updateIcon = function () { if (themeBtn) themeBtn.setAttribute('aria-label', body.classList.contains('dark-mode') ? 'Switch to light mode' : 'Switch to dark mode'); };
        updateIcon();
        if (themeBtn) themeBtn.addEventListener('click', function () {
          var dark = body.classList.toggle('dark-mode');
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
          document.documentElement.classList.toggle('dark-mode-preload', dark);
          // Blogger-indhold (Watch-siden) kender mørk tilstand som html.is-dark
          document.documentElement.classList.toggle('is-dark', dark);
          updateIcon();
        });

        // Søgning i topbaren: forslag mens man skriver, Enter = fuld søgeside.
        // Artikellisten hentes først, når feltet bruges (search-index.json).
        var searchBtn = document.getElementById('searchBtn');
        var closeSearchBtn = document.getElementById('closeSearchBtn');
        var overlay = document.getElementById('searchOverlay');
        var input = document.getElementById('topSearchInput');
        var suggest = document.getElementById('searchSuggest');
        if (searchBtn && overlay) searchBtn.addEventListener('click', function () {
          overlay.classList.add('active'); searchBtn.setAttribute('aria-expanded', 'true');
          setTimeout(function () { input && input.focus(); }, 30);
        });
        if (closeSearchBtn && overlay) closeSearchBtn.addEventListener('click', function () {
          overlay.classList.remove('active'); searchBtn.setAttribute('aria-expanded', 'false');
        });
        if (input && suggest) {
          var data = null, loading = false, idx = -1;
          var norm = function (s) { return String(s || '').toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9#+.]+/g, ' '); };
          var esc = function (s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); };
          var hide = function () { suggest.classList.remove('active'); suggest.innerHTML = ''; idx = -1; };
          var go = function () { var q = input.value.trim(); if (q) location.href = '/search?q=' + encodeURIComponent(q); };
          var load = function () {
            if (data || loading) return; loading = true;
            fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { data = d; loading = false; if (document.activeElement === input) render(); }).catch(function () { loading = false; });
          };
          var render = function () {
            idx = -1;
            var q = input.value.trim();
            if (!q) { hide(); return; }
            if (!data) { load(); suggest.innerHTML = '<div class="search-suggest-empty">Searching…</div>'; suggest.classList.add('active'); return; }
            var ord = norm(q).split(' ').filter(Boolean);
            var hits = data.filter(function (a) { var h = norm(a.t + ' ' + a.d + ' ' + a.e.join(' ')); return ord.every(function (w) { return h.indexOf(w) !== -1; }); }).slice(0, 7);
            if (!hits.length) { suggest.innerHTML = '<div class="search-suggest-empty">No matches. Press Enter to search anyway.</div>'; suggest.classList.add('active'); return; }
            suggest.innerHTML = hits.map(function (a) {
              return '<a class="search-suggest-item" href="' + a.u + '">' + (a.i ? '<img class="search-suggest-thumb" src="' + a.i + '" alt="" loading="lazy">' : '<span class="search-suggest-thumb"></span>') + '<span class="search-suggest-title">' + esc(a.t) + '</span></a>';
            }).join('') + '<a class="search-suggest-footer" href="/search?q=' + encodeURIComponent(q) + '">See all results →</a>';
            suggest.classList.add('active');
          };
          input.addEventListener('focus', load);
          input.addEventListener('input', render);
          input.addEventListener('keydown', function (e) {
            var items = Array.prototype.slice.call(suggest.querySelectorAll('.search-suggest-item, .search-suggest-footer'));
            if (e.key === 'ArrowDown' && items.length) { e.preventDefault(); idx = Math.min(idx + 1, items.length - 1); }
            else if (e.key === 'ArrowUp' && items.length) { e.preventDefault(); idx = Math.max(idx - 1, 0); }
            else if (e.key === 'Enter') { if (idx >= 0 && items[idx]) location.href = items[idx].getAttribute('href'); else go(); return; }
            else if (e.key === 'Escape') { hide(); return; }
            else return;
            items.forEach(function (el, i) { el.classList.toggle('is-active', i === idx); });
            if (items[idx]) items[idx].scrollIntoView({ block: 'nearest' });
          });
          document.addEventListener('click', function (e) { if (!suggest.contains(e.target) && e.target !== input) hide(); });
        }

        // Menuen (skuffe fra højre på alle skærme fra trin 3): klik udenfor eller Escape lukker den
        var menuBtn = document.getElementById('mobileMenuBtn');
        var sidebar = document.getElementById('sidebar');
        if (menuBtn && sidebar) {
          var luk = function () { sidebar.classList.remove('open'); menuBtn.setAttribute('aria-expanded', 'false'); menuBtn.setAttribute('aria-label', 'Open menu'); };
          menuBtn.addEventListener('click', function () { var open = sidebar.classList.toggle('open'); menuBtn.setAttribute('aria-expanded', open); menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); });
          document.addEventListener('click', function (e) { if (!sidebar.contains(e.target) && !menuBtn.contains(e.target)) luk(); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sidebar.classList.contains('open')) { luk(); menuBtn.focus(); } });
        }

        // Megamenuen under "Shelves": åbner ved mus over knappen (computer) eller ved klik/tastatur.
        // Lukker, når musen forlader både knap og menu (lille pause, så man kan nå fra knap til menu),
        // ved klik på den dæmpede side, ved Escape og når tastaturet forlader menuen.
        var megaBtn = document.getElementById('megaBtn');
        var mega = document.getElementById('megaMenu');
        var megaDim = document.getElementById('megaDim');
        if (megaBtn && mega && megaDim) {
          var megaT;
          var megaAaben = function () { clearTimeout(megaT); mega.hidden = false; megaDim.hidden = false; megaBtn.setAttribute('aria-expanded', 'true'); };
          var megaLuk = function () { clearTimeout(megaT); mega.hidden = true; megaDim.hidden = true; megaBtn.setAttribute('aria-expanded', 'false'); };
          var megaLukSnart = function () { clearTimeout(megaT); megaT = setTimeout(megaLuk, 200); };
          megaBtn.addEventListener('click', function () { if (mega.hidden) megaAaben(); else megaLuk(); });
          if (window.matchMedia('(hover: hover)').matches) {
            [megaBtn, mega].forEach(function (el) { el.addEventListener('mouseenter', megaAaben); el.addEventListener('mouseleave', megaLukSnart); });
          }
          megaDim.addEventListener('click', megaLuk);
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !mega.hidden) { megaLuk(); megaBtn.focus(); } });
          mega.addEventListener('focusout', function (e) { if (e.relatedTarget && !mega.contains(e.relatedTarget) && e.relatedTarget !== megaBtn) megaLuk(); });
        }

        // Siden ruller i vinduet (29/9-2026, se CSS'en ved .main-layout) — mål og ryk der.
        var box = document.querySelector('.content-main');
        var topBtn = document.getElementById('scrollTopBtn');
        var bar = document.getElementById('tmaProgress');
        var hdr = document.getElementById('mainHeader');
        var rod = document.scrollingElement || document.documentElement;
        // Målingen venter til næste skærmopdatering (requestAnimationFrame), højst én gang pr. billede, og køres
        // første gang efter 'load'. Før kørte den med det samme, mens siden blev bygget: sidens højde tvang
        // browseren til at regne layoutet ud før tid (PageSpeed 2/11-2026: "forced reflow" 69 ms på mobil).
        // Højden måles kun, når der er rullet — ved toppen er bjælken alligevel 0 og knappen skjult.
        var venter = false;
        var maal = function () {
          venter = false;
          var st = window.scrollY, hoejde = window.innerHeight;
          var max = st > 0 ? rod.scrollHeight - hoejde : 0;
          if (bar) bar.style.width = (max > 0 ? (st / max) * 100 : 0) + '%';
          if (hdr) hdr.classList.toggle('rullet', st > 8);
          if (topBtn) topBtn.classList.toggle('visible', st > 400 && st < max - 120);
        };
        var onScroll = function () {
          if (venter) return;
          venter = true;
          requestAnimationFrame(maal);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        if (document.readyState === 'complete') onScroll();
        else window.addEventListener('load', onScroll, { once: true });
        if (topBtn) topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

        // Kort fader blidt ind, når de rulles i syne
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && box) {
          var els = document.querySelectorAll('.article-card');
          var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (!en.isIntersecting) return;
              var el = en.target; el.classList.add('is-visible'); obs.unobserve(el);
              setTimeout(function () { el.classList.remove('tma-reveal', 'is-visible'); }, 750);
            });
          }, { root: null, rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
          els.forEach(function (el) { el.classList.add('tma-reveal'); obs.observe(el); });
        }

        // Skeleton-glimtet stopper, når kortets billede er hentet
        var loaded = function (img) { var t = img.closest && img.closest('.card-thumb'); if (t) t.classList.add('is-loaded'); };
        document.addEventListener('load', function (e) { if (e.target && e.target.tagName === 'IMG') loaded(e.target); }, true);
        document.addEventListener('error', function (e) { if (e.target && e.target.tagName === 'IMG') loaded(e.target); }, true);
        document.querySelectorAll('.card-thumb img').forEach(function (img) { if (img.complete && img.naturalWidth > 0) loaded(img); });
      });
    </script>
  </body>
</html>
