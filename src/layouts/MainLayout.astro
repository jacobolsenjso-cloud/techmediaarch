        <hr class="nav-sep" />
        {/* Topics foldet sammen (30/9, Jacobs valg C): emne-knapperne står øverst på forsiden, emnesiderne og Trending,
            men i artikler og på mobil er menuen eneste vej til emnerne — derfor foldet, ikke slettet. Åben på en emneside. */}
        <details class="nav-topics" open={ANDRE_EMNER.some((e) => aktiv(emneUrl(e)))}>
