    <button type="button" id="scrollTopBtn" class="scroll-top-btn" aria-label="Scroll to top" title="Scroll to top">↑</button>

    {/* "Cookie settings" åbner Googles egen samtykkedialog igen — vises kun,
        når Googles CMP faktisk er indlæst. */}
    <script is:inline>
      (function () {
        var link = document.getElementById('cookieSettingsLink');
        var sep = document.getElementById('cookieSettingsSep');
        if (!link) return;
        function enable() {
          link.hidden = false; if (sep) sep.hidden = false;
          link.addEventListener('click', function (e) { e.preventDefault(); try { window.googlefc.showRevocationMessage(); } catch (err) {} });
        }
        var tries = 0;
        var t = setInterval(function () {
          if (window.googlefc && typeof window.googlefc.showRevocationMessage === 'function') { clearInterval(t); enable(); }
          else if (++tries > 40) clearInterval(t);
        }, 250);
      })();
    </script>

    <script is:inline>
      document.addEventListener('DOMContentLoaded', function () {
        var body = document.body;
        // YouTube: afspilleren hentes først, når læseren klikker (som på Blogger)
        document.addEventListener('click', function (e) {
          var w = e.target.closest && e.target.closest('.yt-lazy');
          if (!w || w.querySelector('iframe')) return;
          var f = document.createElement('iframe');
          f.src = 'https://www.youtube.com/embed/' + encodeURIComponent(w.getAttribute('data-yt')) + '?autoplay=1';
          f.title = 'YouTube video';
          f.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
          f.setAttribute('allowfullscreen', 'true');
          w.innerHTML = ''; w.appendChild(f);
        });
        // Mørk tilstand
        var themeBtn = document.getElementById('themeToggle');
        // Ikonet (måne/sol) skiftes af CSS'en ud fra body.dark-mode; her opdateres kun knappens tekst til skærmlæsere
        var updateIcon = function () { if (themeBtn) themeBtn.setAttribute('aria-label', body.classList.contains('dark-mode') ? 'Switch to light mode' : 'Switch to dark mode'); };
        updateIcon();
        if (themeBtn) themeBtn.addEventListener('click', function () {
          var dark = body.classList.toggle('dark-mode');
          try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
          document.documentElement.classList.toggle('dark-mode-preload', dark);
          // Blogger-indhold (Watch-siden) kender mørk tilstand som html.is-dark
          document.documentElement.classList.toggle('is-dark', dark);
          updateIcon();
        });

        // Søgning i topbaren: forslag mens man skriver, Enter = fuld søgeside.
        // Artikellisten hentes først, når feltet bruges (search-index.json).
        var searchBtn = document.getElementById('searchBtn');
        var closeSearchBtn = document.getElementById('closeSearchBtn');
        var overlay = document.getElementById('searchOverlay');
        var input = document.getElementById('topSearchInput');
        var suggest = document.getElementById('searchSuggest');
        if (searchBtn && overlay) searchBtn.addEventListener('click', function () {
          overlay.classList.add('active'); searchBtn.setAttribute('aria-expanded', 'true');
          setTimeout(function () { input && input.focus(); }, 30);
        });
        if (closeSearchBtn && overlay) closeSearchBtn.addEventListener('click', function () {
          overlay.classList.remove('active'); searchBtn.setAttribute('aria-expanded', 'false');
        });
        if (input && suggest) {
          var data = null, loading = false, idx = -1;
          var norm = function (s) { return String(s || '').toLowerCase().replace(/&/g, ' and ').replace(/[^a-z0-9#+.]+/g, ' '); };
          var esc = function (s) { return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;'); };
          var hide = function () { suggest.classList.remove('active'); suggest.innerHTML = ''; idx = -1; };
          var go = function () { var q = input.value.trim(); if (q) location.href = '/search?q=' + encodeURIComponent(q); };
          var load = function () {
            if (data || loading) return; loading = true;
            fetch('/search-index.json').then(function (r) { return r.json(); }).then(function (d) { data = d; loading = false; if (document.activeElement === input) render(); }).catch(function () { loading = false; });
          };
          var render = function () {
            idx = -1;
            var q = input.value.trim();
            if (!q) { hide(); return; }
            if (!data) { load(); suggest.innerHTML = '<div class="search-suggest-empty">Searching…</div>'; suggest.classList.add('active'); return; }
            var ord = norm(q).split(' ').filter(Boolean);
            var hits = data.filter(function (a) { var h = norm(a.t + ' ' + a.d + ' ' + a.e.join(' ')); return ord.every(function (w) { return h.indexOf(w) !== -1; }); }).slice(0, 7);
            if (!hits.length) { suggest.innerHTML = '<div class="search-suggest-empty">No matches. Press Enter to search anyway.</div>'; suggest.classList.add('active'); return; }
            suggest.innerHTML = hits.map(function (a) {
              return '<a class="search-suggest-item" href="' + a.u + '">' + (a.i ? '<img class="search-suggest-thumb" src="' + a.i + '" alt="" loading="lazy">' : '<span class="search-suggest-thumb"></span>') + '<span class="search-suggest-title">' + esc(a.t) + '</span></a>';
            }).join('') + '<a class="search-suggest-footer" href="/search?q=' + encodeURIComponent(q) + '">See all results →</a>';
            suggest.classList.add('active');
          };
          input.addEventListener('focus', load);
          input.addEventListener('input', render);
          input.addEventListener('keydown', function (e) {
            var items = Array.prototype.slice.call(suggest.querySelectorAll('.search-suggest-item, .search-suggest-footer'));
            if (e.key === 'ArrowDown' && items.length) { e.preventDefault(); idx = Math.min(idx + 1, items.length - 1); }
            else if (e.key === 'ArrowUp' && items.length) { e.preventDefault(); idx = Math.max(idx - 1, 0); }
            else if (e.key === 'Enter') { if (idx >= 0 && items[idx]) location.href = items[idx].getAttribute('href'); else go(); return; }
            else if (e.key === 'Escape') { hide(); return; }
            else return;
            items.forEach(function (el, i) { el.classList.toggle('is-active', i === idx); });
            if (items[idx]) items[idx].scrollIntoView({ block: 'nearest' });
          });
          document.addEventListener('click', function (e) { if (!suggest.contains(e.target) && e.target !== input) hide(); });
        }

        // Menuen (skuffe fra højre på alle skærme fra trin 3): klik udenfor eller Escape lukker den
        var menuBtn = document.getElementById('mobileMenuBtn');
        var sidebar = document.getElementById('sidebar');
        if (menuBtn && sidebar) {
          var luk = function () { sidebar.classList.remove('open'); menuBtn.setAttribute('aria-expanded', 'false'); menuBtn.setAttribute('aria-label', 'Open menu'); };
          menuBtn.addEventListener('click', function () { var open = sidebar.classList.toggle('open'); menuBtn.setAttribute('aria-expanded', open); menuBtn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu'); });
          document.addEventListener('click', function (e) { if (!sidebar.contains(e.target) && !menuBtn.contains(e.target)) luk(); });
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && sidebar.classList.contains('open')) { luk(); menuBtn.focus(); } });
        }

        // Megamenuen under "Shelves": åbner ved mus over knappen (computer) eller ved klik/tastatur.
        // Lukker, når musen forlader både knap og menu (lille pause, så man kan nå fra knap til menu),
        // ved klik på den dæmpede side, ved Escape og når tastaturet forlader menuen.
        var megaBtn = document.getElementById('megaBtn');
        var mega = document.getElementById('megaMenu');
        var megaDim = document.getElementById('megaDim');
        if (megaBtn && mega && megaDim) {
          var megaT;
          var megaAaben = function () { clearTimeout(megaT); mega.hidden = false; megaDim.hidden = false; megaBtn.setAttribute('aria-expanded', 'true'); };
          var megaLuk = function () { clearTimeout(megaT); mega.hidden = true; megaDim.hidden = true; megaBtn.setAttribute('aria-expanded', 'false'); };
          var megaLukSnart = function () { clearTimeout(megaT); megaT = setTimeout(megaLuk, 200); };
          megaBtn.addEventListener('click', function () { if (mega.hidden) megaAaben(); else megaLuk(); });
          if (window.matchMedia('(hover: hover)').matches) {
            [megaBtn, mega].forEach(function (el) { el.addEventListener('mouseenter', megaAaben); el.addEventListener('mouseleave', megaLukSnart); });
          }
          megaDim.addEventListener('click', megaLuk);
          document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !mega.hidden) { megaLuk(); megaBtn.focus(); } });
          mega.addEventListener('focusout', function (e) { if (e.relatedTarget && !mega.contains(e.relatedTarget) && e.relatedTarget !== megaBtn) megaLuk(); });
        }

        // Siden ruller i vinduet (29/9-2026, se CSS'en ved .main-layout) — mål og ryk der.
        var box = document.querySelector('.content-main');
        var topBtn = document.getElementById('scrollTopBtn');
        var bar = document.getElementById('tmaProgress');
        var hdr = document.getElementById('mainHeader');
        var rod = document.scrollingElement || document.documentElement;
        var onScroll = function () {
          var st = window.scrollY || rod.scrollTop, hoejde = window.innerHeight, max = rod.scrollHeight - hoejde;
          if (bar) bar.style.width = (max > 0 ? (st / max) * 100 : 0) + '%';
          if (hdr) hdr.classList.toggle('rullet', st > 8);
          if (topBtn) topBtn.classList.toggle('visible', st > 400 && st + hoejde < rod.scrollHeight - 120);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll);
        onScroll();
        if (topBtn) topBtn.addEventListener('click', function () { window.scrollTo({ top: 0, behavior: 'smooth' }); });

        // Kort fader blidt ind, når de rulles i syne
        if ('IntersectionObserver' in window && !window.matchMedia('(prefers-reduced-motion: reduce)').matches && box) {
          var els = document.querySelectorAll('.article-card');
          var obs = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (!en.isIntersecting) return;
              var el = en.target; el.classList.add('is-visible'); obs.unobserve(el);
              setTimeout(function () { el.classList.remove('tma-reveal', 'is-visible'); }, 750);
            });
          }, { root: null, rootMargin: '0px 0px -8% 0px', threshold: 0.06 });
          els.forEach(function (el) { el.classList.add('tma-reveal'); obs.observe(el); });
        }

        // Skeleton-glimtet stopper, når kortets billede er hentet
        var loaded = function (img) { var t = img.closest && img.closest('.card-thumb'); if (t) t.classList.add('is-loaded'); };
        document.addEventListener('load', function (e) { if (e.target && e.target.tagName === 'IMG') loaded(e.target); }, true);
        document.addEventListener('error', function (e) { if (e.target && e.target.tagName === 'IMG') loaded(e.target); }, true);
        document.querySelectorAll('.card-thumb img').forEach(function (img) { if (img.complete && img.naturalWidth > 0) loaded(img); });
      });
    </script>
  </body>
</html>
