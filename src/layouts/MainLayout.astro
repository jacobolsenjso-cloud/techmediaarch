        </a>
        <a href="/topic/resources" class={`nav-item ${aktiv('/topic/resources') ? 'active' : ''}`}>
          <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5a2 2 0 0 1 2-2h13v16H6a2 2 0 0 0-2 2z"/><path d="M4 19V5"/><path d="M8 7h7"/></svg>
