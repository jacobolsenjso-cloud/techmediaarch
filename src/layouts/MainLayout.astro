        <a href="/trending" class={`nav-item ${aktiv('/trending') ? 'active' : ''}`}>
          <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="m3 17 6-6 4 4 8-8"/><path d="M15 7h6v6"/></svg>
