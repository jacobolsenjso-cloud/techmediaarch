            ))}
            <a href="/a-z" class="mega-az">A–Z index of every answer →</a>
          </div>
          <div class="mega-col">
            {nyeste && (
              <a href={nyeste.href} class="mega-nyeste">
                {nyeste.image && <img src={nyeste.image} alt="" loading="lazy" decoding="async" />}
                <span class="mega-nyeste-tekst"><span class="mega-badge">Newest answer</span><span class="mega-nyeste-titel">{nyeste.title}</span></span>
              </a>
            )}
            <a href="/p/start-here" class="mega-start">
              <span class="mega-start-ikon" aria-hidden="true"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="m15.5 8.5-2 5-5 2 2-5z"/></svg></span>
              <span class="mega-tekst"><span class="mega-navn">New here? Start here</span><span class="mega-besk">Where to begin if you are new to the archive.</span></span>
            </a>
          </div>
        </div>
      </div>
    </header>
    <div class="mega-dim" id="megaDim" hidden></div>

    <div class="main-layout">
      <aside class="sidebar" id="sidebar">
        {/* De 5 hylder øverst i menuen (mobilens udgave af megamenuen, designlærredet udkast 3) */}
