        <button id="themeToggle" class="icon-btn" aria-label="Toggle dark mode">🌙</button>
      </div>
      <div class="search-overlay" id="searchOverlay">
        <div class="search-input-wrapper">
          <input type="text" placeholder="Search articles..." id="topSearchInput" autocomplete="off" aria-label="Search articles" />
          <div class="search-suggest" id="searchSuggest" role="listbox"></div>
