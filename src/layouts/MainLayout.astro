      </div>

      {/* Megamenuen under "Shelves" (godkendt i designlærredet, udkast 3). Åbner ved mus over knappen eller ved klik/tastatur.
          Fra trin 4 fører hver hylde til sin hyldeside (/shelf/<slug>); tallet er antal artikler på hylden. */}
      <div class="mega" id="megaMenu" role="region" aria-label="Shelves" hidden>
        <div class="mega-inner">
          <div class="mega-col">
            <span class="mega-label">The five shelves</span>
            {HYLDER.map((h) => (
              <a href={hyldeUrl(h)} class="mega-item" style={`--h-farve: ${h.farve}`}>
                <span class="mega-ikon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={h.ikon} /></svg></span>
                <span class="mega-tekst"><span class="mega-navn">{h.navn}</span><span class="mega-besk">{h.besk}</span></span>
                <span class="mega-antal">{iHylde(h).length}</span>
